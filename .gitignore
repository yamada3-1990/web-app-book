# 依存パッケージ(npm install で再生成できる)
node_modules/

# TypeScript のコンパイル結果(tsc で再生成できる)
dist/
build/
*.tsbuildinfo

# 環境変数・秘密情報(APIキーなどをコミットしない)
.env
.env.*
!.env.example

# ログ
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# テスト・カバレッジの出力
coverage/

# キャッシュ
.cache/
.eslintcache

# エディタ・OSの設定ファイル
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
